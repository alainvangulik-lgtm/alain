// Prisma schema voor het voetbalschoenen bestel-en-service-platform.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  KLANT
  ADMIN
}

enum OrderStatus {
  WACHTEND_OP_BETALING
  WACHTEND_OP_BEVESTIGING
  BEVESTIGD
  NIET_BESCHIKBAAR
  BESTELD_BIJ_LEVERANCIER
  ONDERWEG
  GELEVERD
  GEANNULEERD
}

model User {
  id            String    @id @default(cuid())
  naam          String
  email         String    @unique
  wachtwoordHash String?
  rol           Role      @default(KLANT)
  emailVerified DateTime?
  image         String?
  aangemaaktOp  DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  orders   Order[]

  @@map("users")
}

model Order {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  merk        String
  model       String
  maat        Float
  kleur       String
  aantal      Int    @default(1)
  opmerkingen String?

  servicebedrag         Int // in centen
  schoenprijsIndicatief  Int // in centen
  schoenprijsDefinitief  Int? // in centen, ingevuld door admin na beschikbaarheidscheck

  status          OrderStatus @default(WACHTEND_OP_BETALING)
  trackingnummer  String?
  trackingUrl     String?

  molliePaymentId   String? // aanbetaling / initiele betaling
  mollieVervolgId   String? // extra betaling bij prijsverhoging
  akkoordVoorwaarden Boolean @default(false)

  aangemaaktOp DateTime @default(now())
  bijgewerktOp DateTime @updatedAt

  statusHistorie StatusHistorie[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model StatusHistorie {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  toelichting String?
  tijdstip  DateTime    @default(now())

  @@index([orderId])
  @@map("status_historie")
}

// NextAuth (Auth.js) modellen

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
