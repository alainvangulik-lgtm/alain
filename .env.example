# --- Database (Neon of Supabase PostgreSQL connectiestring) -----------------
DATABASE_URL="postgresql://gebruiker:wachtwoord@host:5432/database?sslmode=require"

# --- NextAuth / Auth.js -------------------------------------------------------
# Genereer met: npx auth secret   (of: openssl rand -base64 32)
NEXTAUTH_SECRET="vervang-mij-door-een-lange-random-string"
# Publieke basis-URL van de site (gebruikt voor redirects, Mollie webhooks en e-mails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optioneel: Google-inloggen. Laat leeg om Google-login uit te schakelen.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Admin toegang -------------------------------------------------------------
# Komma-gescheiden lijst van e-mailadressen die automatisch de ADMIN-rol krijgen
# zodra ze inloggen of registreren.
ADMIN_EMAILS="jij@voorbeeld.nl"

# --- Mollie --------------------------------------------------------------------
# Testmodus: begin met je test API-key (test_...). Ga pas live met live_... als
# je klaar bent, zie de opstartinstructies in README.md.
MOLLIE_API_KEY="test_vervang_mij"

# --- E-mail (Resend) -----------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Veldkeuze <bestellingen@jouwdomein.nl>"
